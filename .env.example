# Configuration StockPro
# Renommer ce fichier en .env et adapter les valeurs

# Base de Données
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=stockpro
DB_PORT=3306

# Environnement
ENVIRONMENT=development
DEBUG=true

# Session
SESSION_TIMEOUT=3600
SESSION_NAME=STOCKPRO_SESSION

# Sécurité
BCRYPT_COST=12
CSRF_TOKEN_NAME=_csrf_token

# Email (optionnel)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=

# Logs
LOG_PATH=logs/
LOG_LEVEL=error

# URL de base
BASE_URL=http://localhost/

# Authentification
ALLOW_REGISTER=false
REQUIRE_EMAIL_VERIFY=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Fichiers
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=pdf,csv,xlsx,jpg,png

# Fuseau horaire
TIMEZONE=Europe/Paris

# Version
APP_VERSION=1.0.0
APP_NAME=StockPro
